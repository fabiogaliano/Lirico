    "Hides credit lines and other noise. Start a pattern with / to use a regular expression." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يخفي أسطر الاعتمادات وغيرها من الشوائب. ابدأ النمط بـ / لاستخدام تعبير نمطي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Blendet Credit-Zeilen und anderes Rauschen aus. Beginne ein Muster mit /, um einen regulären Ausdruck zu verwenden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Oculta líneas de créditos y otro ruido. Empieza un patrón con / para usar una expresión regular."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "خطوط اعتبارات و موارد زائد دیگر را پنهان می‌کند. برای استفاده از عبارت باقاعده، الگو را با / شروع کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Masque les crédits et autres lignes parasites. Commencez un motif par / pour utiliser une expression régulière."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Menyembunyikan baris kredit dan gangguan lainnya. Awali pola dengan / untuk menggunakan ekspresi reguler."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nasconde i crediti e altre righe superflue. Inizia un pattern con / per usare un'espressione regolare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "クレジット行などの不要な行を非表示にします。パターンを / で始めると正規表現を使用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "크레딧 행 및 기타 불필요한 내용을 가립니다. 정규 표현식을 사용하려면 패턴을 /로 시작하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Verbergt creditregels en andere ruis. Begin een patroon met / om een reguliere expressie te gebruiken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ukrywa wiersze z informacjami o twórcach i inne zbędne treści. Rozpocznij wzorzec od /, aby użyć wyrażenia regularnego."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Oculta linhas de créditos e outros ruídos. Comece um padrão com / para usar uma expressão regular."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Скрывает строки с авторами и прочий шум. Начните шаблон с /, чтобы использовать регулярное выражение."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Приховує рядки з авторами та інший шум. Почніть шаблон із /, щоб використати регулярний вираз."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "隐藏制作人员信息等干扰行。以 / 开头的规则将作为正则表达式。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "隱藏製作人員名單等干擾行。以 / 開頭的規則會作為正規表示式。"
          }
        }
      }
    },
