    "Start playing the song, then drop the lyrics again." : {
      "comment" : "import error",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ابدأ تشغيل الأغنية، ثم أفلت الكلمات مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Starte die Wiedergabe des Songs und lege den Songtext dann erneut ab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Empieza a reproducir la canción y vuelve a soltar las letras."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "آهنگ را پخش کنید، سپس ترانه را دوباره رها کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lancez la lecture du morceau, puis déposez à nouveau les paroles."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mulai putar lagunya, lalu lepas liriknya lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Avvia la riproduzione del brano, quindi trascina di nuovo il testo."
