    "Lirico won't search lyrics for any song on this album until you pick lyrics for one of them manually." : {
      "comment" : "confirm dialog body",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "لن يبحث Lirico عن كلمات أي أغنية في هذا الألبوم حتى تختار كلمات إحداها يدويًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lirico sucht für keinen Song dieses Albums mehr nach Songtexten, bis du für einen davon manuell einen Songtext auswählst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lirico no buscará letras para ninguna canción de este álbum hasta que elijas manualmente la letra de una de ellas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تا زمانی که ترانه یکی از آهنگ‌های این آلبوم را دستی انتخاب نکنید، Lirico برای هیچ آهنگی از این آلبوم ترانه جستجو نمی‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lirico ne cherchera plus de paroles pour les morceaux de cet album tant que vous n'en aurez pas choisi manuellement pour l'un d'eux."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lirico tidak akan mencari lirik untuk lagu apa pun di album ini sampai Anda memilih lirik untuk salah satunya secara manual."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lirico non cercherà testi per nessun brano di questo album finché non sceglierai manualmente il testo di uno di essi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "このアルバムのいずれかの曲の歌詞を手動で選択するまで、Liricoはこのアルバムのどの曲の歌詞も検索しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "이 앨범의 노래 중 하나에 대해 가사를 직접 선택할 때까지 Lirico는 이 앨범의 어떤 노래도 가사를 검색하지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lirico zoekt geen songteksten meer voor nummers op dit album totdat je voor een ervan handmatig een songtekst kiest."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lirico nie będzie szukać tekstów dla żadnego utworu z tego albumu, dopóki ręcznie nie wybierzesz tekstu dla jednego z nich."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O Lirico não pesquisará letras para nenhuma música deste álbum até que você escolha manualmente a letra de uma delas."
          }
        },
        "ru" : {
          "stringUnit" : {
