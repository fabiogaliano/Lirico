    "Opens when a supported player starts, and quits after the last one closes." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يُفتح عند بدء مشغّل مدعوم، وينتهي بعد إغلاق آخر مشغّل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Öffnet sich, wenn ein unterstützter Player startet, und wird beendet, wenn der letzte geschlossen wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se abre cuando se inicia un reproductor compatible y se cierra cuando se cierra el último."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "با اجرای یک پخش‌کننده پشتیبانی‌شده باز می‌شود و پس از بسته شدن آخرین آن‌ها خارج می‌شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "S'ouvre au lancement d'un lecteur compatible et se ferme après la fermeture du dernier."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Terbuka saat pemutar yang didukung dijalankan, dan keluar setelah pemutar terakhir ditutup."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Si apre all'avvio di un lettore supportato e si chiude dopo la chiusura dell'ultimo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "対応プレーヤーが起動すると開き、最後のプレーヤーが終了すると終了します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "지원되는 플레이어가 시작되면 열리고, 마지막 플레이어가 닫히면 종료됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Opent wanneer een ondersteunde speler start en stopt nadat de laatste is gesloten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Otwiera się po uruchomieniu obsługiwanego odtwarzacza i kończy działanie po zamknięciu ostatniego z nich."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Abre quando um reprodutor compatível é iniciado e encerra depois que o último é fechado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Открывается при запуске поддерживаемого плеера и завершается после закрытия последнего."
          }
        },
        "uk" : {
          "stringUnit" : {
