    "Add each word uncensored once; censored variants like f**k are matched automatically. Only changes what's shown, not saved files or Apple Music." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "أضف كل كلمة مرة واحدة دون حجب؛ تتم مطابقة الأشكال المحجوبة مثل f**k تلقائيًا. يؤثر هذا على ما يُعرض فقط، وليس على الملفات المحفوظة أو Apple Music."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Füge jedes Wort einmal unzensiert hinzu; zensierte Varianten wie f**k werden automatisch erkannt. Ändert nur die Anzeige, nicht gesicherte Dateien oder Apple Music."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Añade cada palabra una vez sin censura; las variantes censuradas como f**k se detectan automáticamente. Solo cambia lo que se muestra, no los archivos guardados ni Apple Music."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "هر واژه را یک بار بدون سانسور اضافه کنید؛ شکل‌های سانسورشده مانند f**k به‌طور خودکار شناسایی می‌شوند. فقط آنچه نمایش داده می‌شود تغییر می‌کند، نه فایل‌های ذخیره‌شده یا Apple Music."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ajoutez chaque mot une seule fois, sans censure ; les variantes censurées comme f**k sont reconnues automatiquement. Seul l'affichage change, pas les fichiers enregistrés ni Apple Music."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tambahkan setiap kata tanpa sensor sekali saja; varian bersensor seperti f**k dicocokkan secara otomatis. Hanya mengubah yang ditampilkan, bukan file yang disimpan atau Apple Music."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aggiungi ogni parola una sola volta, senza censura; le varianti censurate come f**k vengono riconosciute automaticamente. Cambia solo ciò che viene mostrato, non i file salvati né Apple Music."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "伏せ字のない単語を一度ずつ追加してください。f**k のような伏せ字は自動的に照合されます。変わるのは表示のみで、保存済みのファイルや Apple Music には影響しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "각 단어를 검열되지 않은 형태로 한 번만 추가하십시오. f**k 같은 검열된 변형은 자동으로 인식됩니다. 표시되는 내용만 바뀌며 저장된 파일이나 Apple Music은 변경되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Voeg elk woord één keer ongecensureerd toe; gecensureerde varianten zoals f**k worden automatisch herkend. Wijzigt alleen wat er wordt getoond, niet bewaarde bestanden of Apple Music."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dodaj każde słowo raz, bez cenzury; ocenzurowane warianty, takie jak f**k, są dopasowywane automatycznie. Zmienia tylko to, co jest wyświetlane, a nie zapisane pliki ani Apple Music."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Adicione cada palavra sem censura uma única vez; variantes censuradas como f**k são reconhecidas automaticamente. Altera apenas o que é exibido, não os arquivos salvos nem o Apple Music."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Добавьте каждое слово без цензуры один раз; варианты вроде f**k распознаются автоматически. Меняется только отображение, а не сохраненные файлы или Apple Music."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Додайте кожне слово без цензури один раз; варіанти на кшталт f**k розпізнаються автоматично. Змінюється лише відображення, а не збережені файли чи Apple Music."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "每个词只需以未屏蔽的形式添加一次；f**k 等屏蔽变体会自动匹配。仅更改显示内容，不影响已保存的文件或 Apple Music。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "每個字詞只需以未遮蔽的形式加入一次；f**k 等遮蔽變體會自動比對。只會變更顯示內容，不會影響已儲存的檔案或 Apple Music。"
          }
        }
      }
    },
    "Add keyword" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "إضافة كلمة مفتاحية"
