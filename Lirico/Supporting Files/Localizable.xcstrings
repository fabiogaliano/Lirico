    "Hold ⌘ and drag the lyrics to move them. Hiding on mouse-over is off while dragging is on." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اضغط مع الاستمرار على ⌘ واسحب الكلمات لنقلها. يتوقف الإخفاء عند مرور الماوس أثناء تفعيل السحب."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Halte ⌘ gedrückt und ziehe den Songtext, um ihn zu bewegen. Ausblenden beim Überfahren ist deaktiviert, solange Ziehen aktiv ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mantén pulsada ⌘ y arrastra las letras para moverlas. Ocultar al pasar el ratón se desactiva mientras arrastrar está activado."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "⌘ را نگه دارید و ترانه را بکشید تا جابه‌جا شود. وقتی کشیدن فعال است، پنهان شدن هنگام عبور ماوس غیرفعال است."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Maintenez ⌘ et faites glisser les paroles pour les déplacer. Le masquage au survol est désactivé tant que le glissement est activé."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tahan ⌘ dan seret lirik untuk memindahkannya. Selama penyeretan aktif, lirik tidak disembunyikan saat tetikus melintas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tieni premuto ⌘ e trascina il testo per spostarlo. Quando il trascinamento è attivo, il testo non si nasconde al passaggio del mouse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "⌘ を押しながら歌詞をドラッグすると移動できます。ドラッグがオンの間は、マウスオーバー時の非表示はオフになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "⌘ 키를 누른 채 가사를 드래그하여 이동합니다. 드래그가 켜져 있는 동안에는 마우스를 올리면 가리기가 꺼집니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Houd ⌘ ingedrukt en sleep de songtekst om deze te verplaatsen. Verbergen bij aanwijzen met de muis is uit zolang slepen aan staat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Przytrzymaj ⌘ i przeciągnij tekst, aby go przesunąć. Gdy przeciąganie jest włączone, ukrywanie po najechaniu myszą jest wyłączone."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mantenha ⌘ pressionado e arraste as letras para movê-las. Ocultar ao passar o mouse fica desativado enquanto arrastar estiver ativado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Удерживайте ⌘ и перетащите текст, чтобы переместить его. Пока перетаскивание включено, скрытие при наведении отключено."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Утримуйте ⌘ і перетягніть текст, щоб перемістити його. Поки перетягування ввімкнено, приховування при наведенні вимкнено."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "按住 ⌘ 并拖移歌词以移动位置。启用拖移时，鼠标经过时隐藏功能将关闭。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "按住 ⌘ 並拖移歌詞來移動位置。啟用拖移時，滑鼠經過時隱藏的功能會關閉。"
          }
        }
      }
    },
