        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "برای تغییر ترتیب بکشید. نتایج منابع بالاتر بر نتایج هم‌کیفیت از منابع پایین‌تر اولویت دارند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Faites glisser pour réorganiser. À qualité similaire, les résultats des sources placées plus haut l'emportent sur ceux des sources plus basses."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Seret untuk mengubah urutan. Pada kualitas yang serupa, hasil dari sumber yang lebih atas diutamakan dibanding sumber yang lebih bawah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Trascina per riordinare. A parità di qualità, i risultati delle fonti più in alto prevalgono su quelli delle fonti più in basso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ドラッグして並べ替えます。品質が同程度の場合は、上位の参照元の結果が優先されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "드래그하여 순서를 변경합니다. 품질이 비슷하면 위쪽 소스의 결과가 우선합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sleep om de volgorde te wijzigen. Resultaten van hogere bronnen winnen van resultaten van vergelijkbare kwaliteit uit lagere bronnen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Przeciągnij, aby zmienić kolejność. Wyniki z wyższych źródeł mają pierwszeństwo przed wynikami podobnej jakości z niższych."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Arraste para reordenar. Resultados de fontes mais acima prevalecem sobre resultados de qualidade semelhante de fontes mais abaixo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Перетаскивайте для изменения порядка. Результаты от источников выше имеют приоритет над результатами схожего качества от источников ниже."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Перетягуйте, щоб змінити порядок. Результати з вищих джерел мають перевагу над результатами схожої якості з нижчих."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "拖移以重新排序。质量相近时，优先采用排序较高的来源的结果。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "拖移以重新排序。品質相近時，會優先採用排序較高來源的結果。"
          }
        }
      }
    },
