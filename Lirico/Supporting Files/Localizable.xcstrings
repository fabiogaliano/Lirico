    "Drag to reorder. Results from higher sources win over similar-quality results from lower ones." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اسحب لإعادة الترتيب. تتقدّم نتائج المصادر الأعلى على النتائج المماثلة في الجودة من المصادر الأدنى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zum Neuordnen ziehen. Ergebnisse aus höheren Quellen haben Vorrang vor ähnlich guten Ergebnissen aus niedrigeren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Arrastra para reordenar. Los resultados de fuentes superiores prevalecen sobre resultados de calidad similar de fuentes inferiores."
