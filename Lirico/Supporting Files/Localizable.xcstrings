    "Uses an .lrc file next to the song's audio file when the player can tell Lirico where it is (Music and Vox)." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يستخدم ملف .lrc بجوار ملف الصوت الخاص بالأغنية عندما يتمكن المشغّل من إخبار Lirico بمكانه (Music وVox)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Verwendet eine .lrc-Datei neben der Audiodatei des Songs, wenn der Player Lirico ihren Speicherort mitteilen kann (Music und Vox)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Usa un archivo .lrc junto al archivo de audio de la canción cuando el reproductor puede indicarle a Lirico dónde está (Music y Vox)."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "از فایل .lrc کنار فایل صوتی آهنگ استفاده می‌کند، وقتی پخش‌کننده بتواند محل آن را به Lirico بگوید (Music و Vox)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Utilise un fichier .lrc situé à côté du fichier audio du morceau lorsque le lecteur peut indiquer son emplacement à Lirico (Music et Vox)."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Menggunakan file .lrc di samping file audio lagu jika pemutar dapat memberi tahu Lirico lokasinya (Music dan Vox)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Usa un file .lrc accanto al file audio del brano quando il lettore può indicare a Lirico dove si trova (Music e Vox)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "プレーヤーが曲のオーディオファイルの場所を Lirico に伝えられる場合（Music と Vox）、そのファイルと同じ場所にある .lrc ファイルを使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "플레이어가 노래의 오디오 파일 위치를 Lirico에 알려줄 수 있는 경우(Music 및 Vox), 해당 파일 옆의 .lrc 파일을 사용합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gebruikt een .lrc-bestand naast het audiobestand van het nummer als de speler Lirico kan vertellen waar het staat (Music en Vox)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Używa pliku .lrc znajdującego się obok pliku audio utworu, gdy odtwarzacz może przekazać Lirico jego położenie (Music i Vox)."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Usa um arquivo .lrc ao lado do arquivo de áudio da música quando o reprodutor consegue informar ao Lirico onde ele está (Music e Vox)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Использует файл .lrc рядом с аудиофайлом песни, если плеер сообщает Lirico его расположение (Music и Vox)."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Використовує файл .lrc поруч з аудіофайлом пісні, якщо плеєр може повідомити Lirico, де він розташований (Music і Vox)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "当播放器能告知 Lirico 音频文件的位置时（Music 和 Vox），使用歌曲音频文件旁的 .lrc 文件。"
