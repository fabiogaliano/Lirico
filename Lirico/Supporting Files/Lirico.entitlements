<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Sandbox, App Groups and keychain-access-groups are all
	     provisioning-gated: requesting any of them forces Xcode to embed a
	     provisioning profile, which on a free personal team expires after 7
	     days and takes the installed app down with it. Lirico is not
	     distributed through the App Store, so it ships unsandboxed and
	     ad-hoc signed instead, which needs no profile and never expires.
	     Dropping the sandbox also makes the scripting-targets and
	     temporary-exception.apple-events grants unnecessary — an unsandboxed
	     app only needs the automation entitlement below. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
